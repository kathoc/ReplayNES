# Build trees
/build/
/build-*/
/out/
cmake-build-*/
CMakeUserPresets.json
compile_commands.json

# Xcode / macOS
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
xcuserdata/
.DS_Store

# ROMs are never committed (the test ROM is generated by our own code at test time)
*.nes
*.fds
*.unf
*.unif
*.nsf
*.zip
*.7z

# Recorded projects outside test fixtures
*.nesrec/
!tests/fixtures/**/*.nesrec/

# Editors
.vscode/
.idea/
*.swp

# Release packages
/dist/

# Generated by XcodeGen from apps/macos/project.yml
/apps/macos/ReplayNES.xcodeproj/

# Local commercial ROMs - NEVER commit
/roms/
*.[nN][eE][sS]
*.[fF][dD][sS]
*.[uU][nN][iI][fF]

# Claude Code local state (agent worktrees etc.)
/.claude/

# Linux Flatpak build trees (scripts/build-linux-flatpak.sh builds on the Deck; these appear on Linux hosts)
/.flatpak-builder/
/build-flatpak/
/repo/
