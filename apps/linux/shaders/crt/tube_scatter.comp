// tube-webgl.mjs sprogs[axis]: finite-screen scatter, zero extension (direct port; axis = P.extra).
// SPDX-License-Identifier: GPL-2.0-or-later (port); original MIT, see THIRD_PARTY_NOTICES.md
#version 450
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 32, local_size_y = 8) in;
#include "common.glsl"
layout(std430, set = 0, binding = 0) readonly buffer B0 { vec4 src[]; };
layout(std430, set = 0, binding = 1) readonly buffer B1 { float weights[]; };
layout(std430, set = 0, binding = 2) buffer B2 { vec4 outp[]; };
TUBE_PARAMS
void main() {
  uvec2 g = gl_GlobalInvocationID.xy;
  if (int(g.x) >= P.ow || int(g.y) >= P.oh) return;
  int px = int(g.x), py = int(g.y), axis = P.extra;
  precise vec3 sum = vec3(0.0);
  for (int d = -P.radius; d <= P.radius; d++) {
    int qx = px + (axis != 0 ? 0 : d), qy = py + (axis != 0 ? d : 0);
    if (qx >= 0 && qy >= 0 && qx < P.ow && qy < P.oh) sum += src[qy * P.ow + qx].rgb * weights[d + P.radius];
  }
  outp[py * P.ow + px] = vec4(sum, 1.0);
}
