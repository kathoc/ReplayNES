#version 450
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 32, local_size_y = 8) in;
#include "common.glsl"
layout(std430, set = 0, binding = 0) readonly buffer B0 { vec2 carrier[]; };
layout(std430, set = 0, binding = 1) readonly buffer B1 { vec2 basis[]; };
layout(std430, set = 0, binding = 2) readonly buffer B2 { vec4 stats[]; };
layout(std430, set = 0, binding = 3) buffer B3 { vec4 prepared[]; };
void main() {
  uvec2 g = gl_GlobalInvocationID.xy;
  if (g.x >= 682u || g.y >= 240u) return;
  int px = int(g.x), py = int(g.y);
  float porch = stats[py].x;
  precise float Y = 0.0, C = 0.0, S = 0.0;
  for (int k = 0; k < 4; k++) {
    int n = px * 4 + k; Y += porch - carrier[py * 2728 + n].x;
    n = min(n + 2, 2727); precise float a = porch - carrier[py * 2728 + n].x;
    vec2 b = basis[n]; C += a * b.x; S += a * b.y;
  }
  prepared[py * 682 + px] = vec4(Y, C, S, 0.0);
}
