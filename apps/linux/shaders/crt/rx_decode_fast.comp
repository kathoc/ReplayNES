// prepare + decode of one row, fast path (MSL rx_decode_fast): 256 invocations, the 682 prepared
// (Y, C, S) values stay in shared memory; also the row's mean drive (supply_mean).
// SPDX-License-Identifier: GPL-2.0-or-later (port); original MIT, see THIRD_PARTY_NOTICES.md
#version 450
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer B0 { float carrier[]; };
layout(std430, set = 0, binding = 1) readonly buffer B1 { vec2 basis[]; };
layout(std430, set = 0, binding = 2) readonly buffer B2 { vec4 stats[]; };
layout(std430, set = 0, binding = 3) readonly buffer B3 { float gains[]; };
layout(std430, set = 0, binding = 4) writeonly buffer B4 { vec4 outp[]; };
layout(std430, set = 0, binding = 5) writeonly buffer B5 { vec4 means[]; };
shared vec3 prep[682];
shared vec3 part[256];
void main() {
  int py = int(gl_WorkGroupID.x), t = int(gl_LocalInvocationID.x), c = py * 2728;
  vec4 stat = stats[py];
  float porch = stat.x;
  for (int px = t; px < 682; px += 256) {
    float Y = 0.0, C = 0.0, S = 0.0;
    for (int k = 0; k < 4; k++) {
      int n = px * 4 + k; Y += porch - carrier[c + n];
      n = min(n + 2, 2727); float a = porch - carrier[c + n];
      vec2 b = basis[n]; C += a * b.x; S += a * b.y;
    }
    prep[px] = vec3(Y, C, S);
  }
  barrier();
  float gn = gains[py];
  float lengthC = length(stat.yz); vec2 rot = vec2(-stat.y, stat.z) / max(lengthC, 1e-30);
  float factor = gn / ((0.875 / (1.100 - 0.048)) * (1.100 - 0.312));
  vec3 total = vec3(0.0);
  for (int px = t; px < 512; px += 256) {
    float Y = 0.0; vec2 CS = vec2(0.0);
    for (int k = 0; k < 3; k++) Y += prep[px + 8 + k].x;
    for (int k = 0; k < 12; k++) CS += prep[px + 3 + k].yz;
    Y *= factor / 12.0;
    float u = (CS.x * rot.x - CS.y * rot.y) * factor * (-2.0 / 48.0);
    float cv = (CS.y * rot.x + CS.x * rot.y) * factor * (2.0 / 48.0);
    float I = 0.838670568 * cv - 0.544639035 * u, Q = 0.544639035 * cv + 0.838670568 * u;
    vec3 rgb = vec3(Y + 0.956 * I + 0.621 * Q, Y - 0.272 * I - 0.647 * Q, Y - 1.106 * I + 1.703 * Q);
    rgb = pow(clamp(rgb, 0.0, 1.0), vec3(2.2));
    outp[py * 512 + px] = vec4(rgb, 1.0);
    total += rgb;
  }
  part[t] = total;
  barrier();
  for (int w = 128; w > 0; w >>= 1) {
    if (t < w) part[t] += part[t + w];
    barrier();
  }
  if (t == 0) means[py] = vec4(part[0] / 512.0, 1.0);
}
