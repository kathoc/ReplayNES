// tube-webgl.mjs litprog + persistprog in one pass (default path): the emitted light goes into its
// half-float ring slot (slot = P.extra) and the output sums ambient + every slot weighted by the
// phosphor frame fractions, reading the new slot as the same half value it just stored. Same
// arithmetic and order as tube_lit followed by tube_persist.
// SPDX-License-Identifier: GPL-2.0-or-later (port); original MIT, see THIRD_PARTY_NOTICES.md
#version 450
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 32, local_size_y = 8) in;
#include "common.glsl"
layout(std430, set = 0, binding = 0) readonly buffer B0 { vec4 emission[]; };
layout(std430, set = 0, binding = 1) readonly buffer B1 { vec4 broad[]; };
layout(std430, set = 0, binding = 2) buffer B2 { uvec2 ring[]; };
layout(std430, set = 0, binding = 3) readonly buffer B3 { float ambient[]; };
layout(std430, set = 0, binding = 4) writeonly buffer B4 { vec4 outp[]; };
layout(std430, set = 0, binding = 5) readonly buffer B5 { vec4 w[]; };
TUBE_PARAMS
void main() {
  uvec2 g = gl_GlobalInvocationID.xy;
  if (int(g.x) >= P.ow || int(g.y) >= P.oh) return;
  int i = int(g.y) * P.ow + int(g.x);
  precise vec3 lit = emission[i].rgb * P.keep + broad[i].rgb * P.scatterFraction;
  uvec2 fresh = uvec2(packHalf2x16(lit.rg), packHalf2x16(vec2(lit.b, 1.0)));
  ring[P.extra * P.ow * P.oh + i] = fresh;
  precise vec3 v = vec3(ambient[i]);
  for (int s = 0; s < P.depth; s++) {
    uvec2 h = s == P.extra ? fresh : ring[s * P.ow * P.oh + i];
    vec3 c = vec3(unpackHalf2x16(h.x), unpackHalf2x16(h.y).x);
    v += c * w[s].xyz;
  }
  outp[i] = vec4(v, 1.0);
}
