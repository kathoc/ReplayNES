# SDL_GameControllerDB built into the app (docs/design/CONTROLLERS.md): the lines of the target platform of
# third_party/gamecontrollerdb/gamecontrollerdb.txt as a byte array, gamepad_db.inc in the build tree, read by
# src/gamepad_db.cpp. No packaging step on any platform. scripts/update-gamecontrollerdb.sh replaces the table.
#   rnl_gamepad_db(<target>)   adds src/gamepad_db.cpp and the generated include to <target>
# SPDX-License-Identifier: GPL-2.0-or-later
function(rnl_gamepad_db target)
  set(dir ${RNL_REPO_ROOT}/third_party/gamecontrollerdb)
  set(src ${dir}/gamecontrollerdb.txt)
  if(ANDROID)
    set(platform "Android")
  elseif(WIN32)
    set(platform "Windows")
  elseif(APPLE)
    set(platform "Mac OS X")
  else()
    set(platform "Linux")
  endif()
  file(STRINGS ${src} lines REGEX "platform:${platform},")
  list(LENGTH lines count)
  list(JOIN lines "\n" text)
  set(out ${CMAKE_CURRENT_BINARY_DIR}/gamepad_db)
  file(WRITE ${out}/gamecontrollerdb-platform.txt "${text}\n")
  file(READ ${out}/gamecontrollerdb-platform.txt hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n"
         bytes "${bytes}")
  file(STRINGS ${dir}/VERSION version LIMIT_COUNT 1)
  string(REGEX MATCH "^[0-9a-f]+" commit "${version}")
  file(WRITE ${out}/gamepad_db.inc
       "// Generated by apps/desktop/gamepad_db.cmake from third_party/gamecontrollerdb (do not edit).\n"
       "static const unsigned char kGamepadDb[] = {\n${bytes}};\n"
       "static const int kGamepadDbLines = ${count};\n"
       "static const char kGamepadDbPlatform[] = \"${platform}\";\n"
       "static const char kGamepadDbCommit[] = \"${commit}\";\n")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${src} ${dir}/VERSION)
  target_sources(${target} PRIVATE ${RNL_DESKTOP_DIR}/src/gamepad_db.cpp)
  target_include_directories(${target} PRIVATE ${out})
endfunction()
