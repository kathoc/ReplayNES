    "Audio is muted while paused, rewinding, seeking, in slow motion or fast-forwarding.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止・巻き戻し・シーク・スロー・早送り中は無音になります。"
          }
        }
      }
    },
    "Audio is muted while paused, rewinding, seeking, in slow motion or fast-forwarding. Sound keeps playing when ReplayNES isn’t in front.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止・巻き戻し・シーク・スロー・早送り中は無音になります。ReplayNES が前面になくても音は止まりません。"
          }
        }
      }
    },
