    "Automatically installed updates are applied the next time you quit the app. If there are unsaved changes, you are asked to save before quitting.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動インストールされた更新は、次にアプリを終了したときに適用されます。未保存の変更がある場合は終了前に保存を確認します。"
          }
        }
      }
    },
    "Autosave (last)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動保存 (直近)"
          }
        }
      }
    },
