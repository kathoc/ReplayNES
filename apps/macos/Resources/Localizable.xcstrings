    "Limits flashes of 15% or more of the screen to 1 per second and also softens the remaining small flicker.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の 15% 以上の明滅を 1 秒に 1 回までに抑え、残る小さなちらつきも弱めます。"
          }
        }
      }
    },
