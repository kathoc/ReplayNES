          "stringUnit": {
            "state": "translated",
            "value": "ピクセル比 8:7"
          }
        }
      }
    },
    "8:7 pixel aspect ratio (as on a CRT TV)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピクセル比 8:7（ブラウン管の見た目）"
          }
