    "Steam is running. Close Steam first (Desktop Mode: Steam menu → Exit), then try again. Artwork that could be installed appears after Steam restarts.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam が起動中です。先に Steam を終了してください（デスクトップモード: Steam メニュー → 終了）。そのあと、もう一度お試しください。導入できたアートワークは Steam の再起動後に表示されます。"
          }
        }
      }
    },
    "Steam Keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam キーボード"
          }
