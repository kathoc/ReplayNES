// ReplayNES.exe resources: the app icon (Explorer, taskbar; SDL uses the first icon for the
// window too), the manifest (UTF-8 code page, per-monitor DPI v2) and the version information.
// Configured by apps/windows/CMakeLists.txt.
#include <winver.h>

1 ICON "@RNW_ICON@"
1 24 "@RNW_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @RNW_VERSION_COMMA@,0
 PRODUCTVERSION @RNW_VERSION_COMMA@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "ReplayNES"
      VALUE "FileDescription", "ReplayNES"
      VALUE "FileVersion", "@RNW_VERSION@"
      VALUE "InternalName", "ReplayNES"
      VALUE "LegalCopyright", "GPL-2.0-or-later"
      VALUE "OriginalFilename", "ReplayNES.exe"
      VALUE "ProductName", "ReplayNES"
      VALUE "ProductVersion", "@RNW_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
