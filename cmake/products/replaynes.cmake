set(RN_PRODUCT_OVERSCAN_CROP ON)
set(RN_PRODUCT_LINUX_DESKTOP_FILE "${CMAKE_CURRENT_LIST_DIR}/../../apps/linux/flatpak/io.github.replaynes.ReplayNES.desktop")
